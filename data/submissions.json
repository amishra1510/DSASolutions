  "leetcode::1::c++": {
    "platform": "LeetCode",
    "problem_id": "1",
    "title": "Two Sum",
    "slug": "two-sum",
    "language": "C++",
    "source": "class Solution {\npublic:\n    vector<int> twoSum(vector<int>& nums, int target) {\n        unordered_map<int, int>mp;\n\n        for(int i = 0; i<nums.size(); i++){\n            int need  = target -nums[i];\n\n            if(mp.find(need) != mp.end()){\n                return {mp[need], i};\n            }\n            mp[nums[i]] =i;\n        }\n        return{};\n        \n    }\n};",
    "accepted_at": "1787153279",
    "difficulty": "Easy",
    "tags": [
